generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WAREHOUSE
  FORWARDER
  CUSTOMER
  ADMIN
}

enum BusinessType {
  OVERSEAS
  DOMESTIC
}

enum VehicleStatus {
  PENDING_INBOUND
  IN_STOCK
  PENDING_RELEASE
  PENDING_PICKUP
  OUTBOUND
  PENDING_RECEIPT
  COMPLETED
  EXCEPTION
}

enum EventType {
  CREATED
  INBOUND
  MERCHANT_RELEASE
  TRANSFER_DOC_NOTICE
  CUSTOMER_RELEASE
  PICKUP_CREATED
  OUTBOUND
  DRIVER_SIGNED
  RECEIPT_DELIVERED
  OUTBOUND_NOTICE_DELIVERED
  CUSTOMER_RECEIPT_DELIVERED
  AGENT_RECEIPT_DELIVERED
  CORRECTION
  EXCEPTION
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String
  passwordHash    String
  sessionVersion  Int                  @default(0)
  role            Role
  active          Boolean              @default(true)
  scopes          Json                 @default("{}")
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id])
  warehouseScopes UserWarehouseScope[]
  createdAt       DateTime             @default(now())
  events          InventoryEvent[]
  audits          AuditLog[]
}

model Customer {
  id       String    @id @default(cuid())
  name     String    @unique
  vehicles Vehicle[]
  users    User[]
}

model Warehouse {
  id         String               @id @default(cuid())
  name       String
  location   String
  bonded     Boolean              @default(false)
  vehicles   Vehicle[]
  userScopes UserWarehouseScope[]

  @@unique([name, location])
}

model UserWarehouseScope {
  userId      String
  warehouseId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([warehouseId])
}

model BusinessBatch {
  id              String       @id @default(cuid())
  type            BusinessType
  referenceNo     String
  portOfLoad      String?
  portOfDischarge String?
  vesselVoyage    String?
  etd             DateTime?
  eta             DateTime?
  manufacturer    String?
  extra           Json         @default("{}")
  vehicles        Vehicle[]
  createdAt       DateTime     @default(now())

  @@unique([type, referenceNo])
}

model Vehicle {
  id               String           @id @default(cuid())
  vin              String           @unique
  model            String
  brand            String?
  hsCode           String?
  status           VehicleStatus    @default(PENDING_INBOUND)
  version          Int              @default(1)
  inboundAt        DateTime?
  inboundAmount    Decimal?         @db.Decimal(18, 2)
  inboundBoeNo     String?
  outboundAt       DateTime?
  outboundBoeNo    String?
  outboundBoeTitle String?
  outboundAmount   Decimal?         @db.Decimal(18, 2)
  pickupDetails    String?
  notes            String?
  extra            Json             @default("{}")
  batchId          String?
  batch            BusinessBatch?   @relation(fields: [batchId], references: [id])
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id])
  warehouseId      String?
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id])
  events           InventoryEvent[]
  pickupItems      PickupItem[]
  attachments      Attachment[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model InventoryEvent {
  id             String    @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  type           EventType
  occurredAt     DateTime
  payload        Json      @default("{}")
  correctionOfId String?
  actorId        String?
  actor          User?     @relation(fields: [actorId], references: [id])
  attachments    Attachment[]
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@index([vehicleId, occurredAt])
}

model PickupTask {
  id               String       @id @default(cuid())
  taskNo           String       @unique
  token            String       @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  submittedAt      DateTime?
  driverSubmission Json?
  items            PickupItem[]
  createdAt        DateTime     @default(now())
}

model SystemSetting {
  id            String   @id @default("default")
  publicBaseUrl String?
  updatedAt     DateTime @updatedAt
}

model PickupItem {
  pickupTaskId String
  vehicleId    String
  pickupTask   PickupTask @relation(fields: [pickupTaskId], references: [id])
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id])

  @@id([pickupTaskId, vehicleId])
}

model Attachment {
  id               String          @id @default(cuid())
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id])
  inventoryEventId String?
  inventoryEvent   InventoryEvent? @relation(fields: [inventoryEventId], references: [id])
  objectKey        String
  fileName         String
  mimeType         String
  size             Int
  createdAt        DateTime        @default(now())

  @@index([objectKey])
  @@index([inventoryEventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorLabel String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
