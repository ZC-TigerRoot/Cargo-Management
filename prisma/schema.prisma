generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WAREHOUSE
  FORWARDER
  CUSTOMER
  ADMIN
}

enum BusinessType {
  OVERSEAS
  DOMESTIC
}

enum VehicleStatus {
  PENDING_INBOUND
  IN_STOCK
  PENDING_RELEASE
  PENDING_PICKUP
  OUTBOUND
  PENDING_RECEIPT
  COMPLETED
  EXCEPTION
}

enum EventType {
  CREATED
  INBOUND
  MERCHANT_RELEASE
  TRANSFER_DOC_NOTICE
  CUSTOMER_RELEASE
  PICKUP_CREATED
  OUTBOUND
  DRIVER_SIGNED
  RECEIPT_DELIVERED
  OUTBOUND_NOTICE_DELIVERED
  CUSTOMER_RECEIPT_DELIVERED
  AGENT_RECEIPT_DELIVERED
  CORRECTION
  EXCEPTION
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String
  passwordHash    String
  sessionVersion  Int                  @default(0)
  role            Role
  active          Boolean              @default(true)
  scopes          Json                 @default("{}")
  customerId      String?
  customer        Customer?            @relation(fields: [customerId], references: [id])
  warehouseScopes UserWarehouseScope[]
  createdAt       DateTime             @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date
  recordSequence  BigInt               @unique @default(autoincrement())
  events          InventoryEvent[]
  audits          AuditLog[]
}

model Customer {
  id       String    @id @default(cuid())
  name     String    @unique
  vehicles Vehicle[]
  users    User[]
}

model Warehouse {
  id         String               @id @default(cuid())
  name       String
  location   String
  bonded     Boolean              @default(false)
  batches    BusinessBatch[]
  vehicles   Vehicle[]
  userScopes UserWarehouseScope[]

  @@unique([name, location])
}

model UserWarehouseScope {
  userId      String
  warehouseId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([warehouseId])
}

model BusinessBatch {
  id              String       @id @default(cuid())
  type            BusinessType
  referenceNo     String
  warehouseKey    String       @default("__unassigned__")
  warehouseId     String?
  warehouse       Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  portOfLoad      String?
  portOfDischarge String?
  vesselVoyage    String?
  etd             DateTime?    @db.Date
  eta             DateTime?    @db.Date
  manufacturer    String?
  extra           Json         @default("{}")
  vehicles        Vehicle[]
  createdAt       DateTime     @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date

  @@unique([type, referenceNo, warehouseKey])
  @@index([warehouseId])
}

model Vehicle {
  id               String           @id @default(cuid())
  vin              String?          @unique
  model            String?
  brand            String?
  hsCode           String?
  status           VehicleStatus    @default(PENDING_INBOUND)
  version          Int              @default(1)
  currentCycle     Int              @default(1)
  inboundAt        DateTime?        @db.Date
  inventoryDays    Int?
  inboundAmount    Decimal?         @db.Decimal(18, 2)
  inboundBoeNo     String?
  outboundAt       DateTime?        @db.Date
  outboundBoeNo    String?
  outboundBoeTitle String?
  outboundAmount   Decimal?         @db.Decimal(18, 2)
  pickupDetails    String?
  notes            String?
  extra            Json             @default("{}")
  batchId          String?
  batch            BusinessBatch?   @relation(fields: [batchId], references: [id])
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id])
  warehouseId      String?
  warehouse        Warehouse?       @relation(fields: [warehouseId], references: [id])
  events           InventoryEvent[]
  pickupItems      PickupItem[]
  attachments      Attachment[]
  createdAt        DateTime         @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date
  updatedAt        DateTime         @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date
  updateSequence   BigInt           @unique @default(autoincrement())
}

model InventoryEvent {
  id             String       @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  cycle          Int          @default(1)
  type           EventType
  occurredAt     DateTime     @db.Date
  payload        Json         @default("{}")
  correctionOfId String?
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  attachments    Attachment[]
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date
  recordSequence BigInt       @unique @default(autoincrement())

  @@index([vehicleId, recordSequence])
}

model PickupTask {
  id               String       @id @default(cuid())
  taskNo           String       @unique
  token            String       @unique
  expiresAt        DateTime     @db.Date
  revokedAt        DateTime?    @db.Date
  submittedAt      DateTime?    @db.Date
  driverSubmission Json?
  items            PickupItem[]
  createdAt        DateTime     @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date
  recordSequence   BigInt       @unique @default(autoincrement())
}

model SystemSetting {
  id            String   @id @default("default")
  publicBaseUrl String?
  updatedAt     DateTime @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date
}

model PickupItem {
  pickupTaskId String
  vehicleId    String
  cycle        Int        @default(1)
  pickupTask   PickupTask @relation(fields: [pickupTaskId], references: [id])
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id])

  @@id([pickupTaskId, vehicleId])
}

model Attachment {
  id               String          @id @default(cuid())
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id])
  inventoryEventId String?
  inventoryEvent   InventoryEvent? @relation(fields: [inventoryEventId], references: [id])
  objectKey        String
  fileName         String
  mimeType         String
  size             Int
  createdAt        DateTime        @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date

  @@index([objectKey])
  @@index([inventoryEventId])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id])
  actorLabel     String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  reason         String?
  ip             String?
  createdAt      DateTime @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'Asia/Shanghai'::text))::date")) @db.Date
  recordSequence BigInt   @unique @default(autoincrement())

  @@index([entityType, entityId, recordSequence])
}
