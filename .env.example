# PostgreSQL connection used by Prisma. Usernames and passwords are URL-encoded by the app.
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="cargo_management"
DB_USER="cargo"
DB_PASSWORD="replace-with-a-strong-database-password"

# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Enable only when the app port is private and a trusted reverse proxy overwrites
# X-Forwarded-For/X-Real-IP. This allows reliable audit IPs and IP login limits.
TRUST_PROXY="false"

# Public origin used in pickup QR links. Use HTTPS in production and do not add a path.
APP_URL="http://localhost:3000"

# Initial administrator used by `pnpm db:seed`. The password must be at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_NAME="系统管理员"

# Demo records must remain disabled in production.
SEED_DEMO_DATA="false"

# Persistent, writable, non-public directory for driver photos.
# Use an absolute path in production, for example /www/wwwroot/cargo-management/data/uploads.
UPLOAD_DIR="./data/uploads"

# Port read by `next dev` and `next start`.
PORT="3000"
