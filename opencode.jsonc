{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "coverage/**",
      "data/uploads/**"
    ]
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--acceptInsecureCerts"],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "sudo *": "ask",
      "rm *": "ask",
      "docker compose down*": "ask",
      "pnpm db:deploy*": "ask",
      "pnpm db:seed*": "ask"
    }
  }
}
